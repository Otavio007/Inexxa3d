{
  "expo": {
    "name": "INNEXA 3D",
    "slug": "innexa-3d",
    "scheme": "innexa3d",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      "expo-document-picker",
      "expo-image-picker",
      "./plugins/withAndroidPaths"
    ],
    "android": {
      "package": "com.innexa3d.gestao",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png",
      "name": "INNEXA 3D"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f5fb694a-8eec-4120-8051-de75a557cb36"
      }
    },
    "owner": "otavioribeiro"
  }
}
